  "plugin_capability_matrix_invariants": {
    "capability_dimensions": [
      "agent_cli_install_distribution",
      "cli_bundling_bootstrap",
      "filesystem_access",
      "cli_invocation",
      "cli_report_rendering",
      "annotation_apis",
      "background_runs",
      "repair_action_ui",
      "trace_deep_links"
    ],
    "limited_adapter_core_capabilities": [
      "agent_cli_install_distribution",
      "cli_bundling_bootstrap",
      "filesystem_access",
      "cli_invocation"
    ],
    "rich_ux_capabilities": [
      "cli_report_rendering",
      "annotation_apis",
      "background_runs",
      "repair_action_ui",
      "trace_deep_links"
    ],
    "out_of_scope_surface_kinds": ["ide-extension", "ci-adapter", "hosted-checks"],
    "out_of_scope_distribution_surfaces": ["ide-extension-store", "ci-platform"],
    "tier_stage9_consequences": {
      "full-plugin": "proceed-full-plugin",
      "limited-adapter": "proceed-limited-adapter",
      "cli-first-fallback": "defer-stage9-cli-first",
      "future-adapter-evidence": "future-evidence-only"
    },
    "null_decision_stage9_consequences": {
      "cli-first-fallback": "defer-stage9-cli-first",
      "none": "future-evidence-only"
    },
    "selectable_tiers": ["full-plugin", "limited-adapter"]
  },
