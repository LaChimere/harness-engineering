{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/agent-runner.schema.json",
  "title": "Agent runner",
  "type": "object",
  "required": [
    "schema_version",
    "runner_id",
    "model_profile",
    "prompt_adapter",
    "tool_adapter",
    "task_input",
    "sandbox",
    "approval_policy",
    "trace_output",
    "credential_reference",
    "budgets",
    "timeout_seconds",
    "verifier_binding"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "runner_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "model_profile": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "prompt_adapter": {
      "type": "object",
      "required": ["kind", "template"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["native", "mcp", "raw"]
        },
        "template": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "tool_adapter": {
      "type": "object",
      "required": ["kind", "policy"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["native", "mcp", "none"]
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "task_input": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "sandbox": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "approval_policy": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "trace_output": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "trace_redaction": {
      "type": "object",
      "required": ["recorded_fields", "credential_env_vars", "refuse_credential_env_references"],
      "properties": {
        "recorded_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "run_id",
              "session_id",
              "inputs",
              "environment_snapshot",
              "started_at",
              "completed_at",
              "duration_ms",
              "exit_code",
              "determinism_level",
              "credential_reference",
              "budgets",
              "usage",
              "actions",
              "logs",
              "artifact_links"
            ]
          }
        },
        "credential_env_vars": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        },
        "refuse_credential_env_references": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "credential_reference": {
      "$ref": "common.schema.json#/$defs/credentialReference"
    },
    "budgets": {
      "$ref": "common.schema.json#/$defs/agentBudgets"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "verifier_binding": {
      "type": "object",
      "required": ["eval_task", "verifier"],
      "properties": {
        "eval_task": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "verifier": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
