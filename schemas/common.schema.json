{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/common.schema.json",
  "title": "Harness Engineering shared schema definitions",
  "description": "Shared draft 2020-12 definitions reused by Harness Engineering artifact schemas.",
  "$defs": {
    "schemaVersion": {
      "$ref": "#/$defs/semver",
      "description": "Per-artifact schema version. Compatibility ranges are enforced through harness.yaml engines.schemas."
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "schemaRange": {
      "type": "string",
      "description": "A semantic-version compatibility range interpreted by the harness CLI.",
      "minLength": 1,
      "pattern": "^(?:[~^]?\\d+(?:\\.\\d+){0,2}|[<>]=?\\d+(?:\\.\\d+){0,2}|\\*)(?:\\s+(?:[~^]?\\d+(?:\\.\\d+){0,2}|[<>]=?\\d+(?:\\.\\d+){0,2}|\\*))*$"
    },
    "artifactRef": {
      "type": "string",
      "description": "A repo-relative path, URI, or fragment reference to another harness artifact.",
      "minLength": 1,
      "not": {
        "pattern": "\\n"
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sandboxTier": {
      "type": "string",
      "enum": ["none", "process", "worktree", "container", "vm"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error", "critical"]
    },
    "riskClass": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "failureCode": {
      "type": "string",
      "description": "Stable failure code. Membership is checked against the configured failure taxonomy by CLI tooling.",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "artifactLink": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/artifactRef"
        },
        "media_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidenceLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactLink"
      },
      "default": []
    },
    "command": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "working_directory": {
          "$ref": "#/$defs/artifactRef"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "trustRequirements": {
      "type": "object",
      "description": "Execution trust and sandbox declaration for local checks, eval verifiers, and repair actions.",
      "required": [
        "trust_level",
        "sandbox_required",
        "network_access",
        "secret_access",
        "host_file_access",
        "allowed_inputs",
        "allowed_outputs"
      ],
      "properties": {
        "trust_level": {
          "type": "string",
          "enum": ["untrusted", "sandboxed", "trusted"]
        },
        "sandbox_required": {
          "$ref": "#/$defs/sandboxTier"
        },
        "network_access": {
          "type": "boolean"
        },
        "secret_access": {
          "type": "boolean"
        },
        "host_file_access": {
          "type": "boolean"
        },
        "allowed_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "allowed_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": false
    },
    "credentialReference": {
      "type": "object",
      "description": "Reference to credentials without embedding secret material.",
      "required": ["source", "name", "purpose", "scope"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["env", "file", "secret-manager", "host-vault", "stub"]
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scope": {
          "type": "string",
          "enum": ["per-run", "per-session", "repository", "organization"]
        }
      },
      "additionalProperties": false
    },
    "agentBudgets": {
      "type": "object",
      "description": "Cost, token, and request budget gates for model execution.",
      "required": ["max_cost_usd", "max_requests", "enforcement", "scope"],
      "anyOf": [
        {
          "required": ["max_input_tokens"]
        },
        {
          "required": ["max_output_tokens"]
        },
        {
          "required": ["max_total_tokens"]
        }
      ],
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "enforcement": {
          "type": "string",
          "enum": ["hard"]
        },
        "scope": {
          "type": "string",
          "enum": ["per-run", "per-session"]
        }
      },
      "additionalProperties": false
    },
    "usageAccounting": {
      "type": "object",
      "description": "Observed model usage and cost evidence for budget enforcement and reporting.",
      "required": [
        "billed_model_id",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "requests",
        "incurred_cost_usd",
        "source"
      ],
      "properties": {
        "billed_model_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "incurred_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "enum": ["provider-reported", "computed", "stub"]
        }
      },
      "additionalProperties": false
    }
  }
}
