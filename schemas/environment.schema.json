{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/environment.schema.json",
  "title": "Execution environment",
  "type": "object",
  "required": [
    "schema_version",
    "environment_id",
    "isolation",
    "resources",
    "dependencies",
    "startup",
    "health_check",
    "teardown"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "environment_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "isolation": {
      "type": "object",
      "required": ["kind", "assurance"],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/sandboxTier"
        },
        "assurance": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "image": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["process", "worktree"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "assurance": {
                "enum": ["low", "medium"]
              }
            }
        }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["container", "vm"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["image"]
          }
        }
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["cpu", "memory_mb", "timeout_seconds"],
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": ["lockfiles", "tools"],
      "properties": {
        "lockfiles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "version": {
                "$ref": "common.schema.json#/$defs/schemaRange"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "startup": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/command"
      }
    },
    "health_check": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/command"
      }
    },
    "teardown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/command"
      }
    },
    "sandbox_policy": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    }
  },
  "additionalProperties": false
}
