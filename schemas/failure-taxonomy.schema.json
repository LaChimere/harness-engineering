{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/failure-taxonomy.schema.json",
  "title": "Failure taxonomy",
  "type": "object",
  "required": ["schema_version", "taxonomy_id", "codes"],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "taxonomy_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "category", "description"],
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/failureCode"
          },
          "category": {
            "type": "string",
            "enum": [
              "tooling",
              "execution",
              "verification",
              "context",
              "routing",
              "progress",
              "harness",
              "environment",
              "budget",
              "credential",
              "agent",
              "model",
              "sandbox",
              "approval"
            ]
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
