{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/harness.schema.json",
  "title": "Harness configuration",
  "description": "Repo-local harness.yaml substrate that composes schema-backed harness artifacts.",
  "type": "object",
  "required": [
    "schema_version",
    "harness",
    "engines",
    "context",
    "environment",
    "approval_policy",
    "sandbox",
    "model_profiles",
    "agent_runners",
    "traces",
    "evals",
    "doctor",
    "continuity",
    "gc"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "harness": {
      "type": "object",
      "required": ["name", "failure_taxonomy"],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "failure_taxonomy": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "engines": {
      "type": "object",
      "required": ["cli", "schemas"],
      "properties": {
        "cli": {
          "$ref": "common.schema.json#/$defs/schemaRange"
        },
        "schemas": {
          "type": "object",
          "required": [
            "harness",
            "approval-policy",
            "sandbox-policy",
            "environment",
            "model-profile",
            "failure-taxonomy",
            "continuity-state",
            "self-verification",
            "doctor-result",
            "health-result",
            "eval-task",
            "agent-runner",
            "runner-readiness",
            "recurring-profile",
            "profile-run",
            "trace",
            "run-result",
            "scoreboard",
            "judge-policy",
            "judge-result",
            "gc-evidence"
          ],
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/schemaRange"
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["maps"],
      "properties": {
        "maps": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "approval_policy": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "sandbox": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "model_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "agent_runners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "traces": {
      "type": "object",
      "required": ["output_dir"],
      "properties": {
        "output_dir": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": false
    },
    "evals": {
      "type": "object",
      "required": ["suites", "run_results"],
      "properties": {
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "version", "tasks"],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "version": {
                "$ref": "common.schema.json#/$defs/semver"
              },
              "tasks": {
                "$ref": "common.schema.json#/$defs/artifactRef"
              }
            },
            "additionalProperties": false
          }
        },
        "run_results": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "scoreboards": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "judges": {
      "type": "object",
      "description": "Inferential judge policy declarations. Judge result artifacts remain runtime evidence and are not deterministic verifier results.",
      "required": ["policies"],
      "properties": {
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": false
    },
    "doctor": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^builtin:[a-z0-9-]+$"
              },
              {
                "type": "object",
                "required": ["id", "path", "trust_requirements"],
                "properties": {
                  "id": {
                    "$ref": "common.schema.json#/$defs/nonEmptyString"
                  },
                  "path": {
                    "$ref": "common.schema.json#/$defs/artifactRef"
                  },
                  "trust_requirements": {
                    "$ref": "common.schema.json#/$defs/trustRequirements"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["output_dir", "checks"],
      "properties": {
        "output_dir": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "command", "trust_requirements"],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "command": {
                "$ref": "common.schema.json#/$defs/command"
              },
              "trust_requirements": {
                "$ref": "common.schema.json#/$defs/trustRequirements"
              },
              "artifacts": {
                "$ref": "common.schema.json#/$defs/evidenceLinks"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "continuity": {
      "type": "object",
      "required": ["state_dir", "startup_smoke_test"],
      "properties": {
        "state_dir": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "startup_smoke_test": {
          "$ref": "common.schema.json#/$defs/command"
        },
        "handoff_dir": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "session_id_env": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "gc": {
      "type": "object",
      "required": ["evidence_dir"],
      "properties": {
        "evidence_dir": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "recurring_profiles": {
      "type": "object",
      "required": ["output_dir", "profiles"],
      "properties": {
        "output_dir": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
