{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/model-profile.schema.json",
  "title": "Model profile",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "profile_id",
    "provider",
    "model_id",
    "tool_call_format",
    "context_window_tokens",
    "reasoning_budget",
    "prompt_formatting",
    "tool_result_formatting",
    "pricing",
    "known_quirks"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "type": "string",
      "enum": ["stub", "live"]
    },
    "profile_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "provider": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "model_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "tool_call_format": {
      "type": "string",
      "enum": ["openai-function", "anthropic-tool-use", "mcp", "raw-json"]
    },
    "context_window_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "reasoning_budget": {
      "type": "object",
      "required": ["max_tokens", "mode"],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "explicit"]
        }
      },
      "additionalProperties": false
    },
    "prompt_formatting": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "tool_result_formatting": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "known_quirks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pricing": {
      "type": "object",
      "description": "Pricing metadata used to compute budget evidence when provider-reported cost is unavailable.",
      "required": ["currency", "input_per_million", "output_per_million", "source"],
      "properties": {
        "currency": {
          "type": "string",
          "enum": ["USD"]
        },
        "input_per_million": {
          "type": "number",
          "minimum": 0
        },
        "output_per_million": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
