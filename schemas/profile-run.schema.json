{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/profile-run.schema.json",
  "title": "Profile run",
  "description": "Single deterministic execution result for a recurring maintenance profile.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "harness_version",
    "generated_at",
    "profile_ref",
    "profile_id",
    "profile_version",
    "evidence_inputs",
    "trigger_evaluation",
    "stop_condition_evaluation",
    "actions_taken",
    "handoff",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "harness_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_ref": {
      "$ref": "#/$defs/hashedArtifactRef"
    },
    "profile_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "profile_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "declared_capability_id": {
      "type": "null",
      "default": null
    },
    "previous_run_ref": {
      "$ref": "#/$defs/hashedArtifactRef"
    },
    "evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["gc-evidence", "health-result", "profile-run"]
          },
          "path": {
            "$ref": "common.schema.json#/$defs/artifactRef"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "media_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "trigger_evaluation": {
      "$ref": "#/$defs/conditionEvaluation"
    },
    "stop_condition_evaluation": {
      "allOf": [
        {
          "$ref": "#/$defs/conditionEvaluation"
        },
        {
          "type": "object",
          "required": ["status", "clean_streak"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["met", "not_met", "inconclusive"]
            },
            "clean_streak": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": {
            "const": "summary"
          },
          "summary": {
            "type": "object",
            "required": ["status", "gc_findings", "health_status", "clean_streak"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["met", "not_met", "inconclusive"]
              },
              "gc_findings": {
                "type": "integer",
                "minimum": 0
              },
              "health_status": {
                "type": "string",
                "enum": ["passed", "failed", "error", "missing"]
              },
              "clean_streak": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "handoff": {
      "type": "object",
      "required": ["kind", "status", "next_step", "summary"],
      "properties": {
        "kind": {
          "const": "profile-run"
        },
        "status": {
          "type": "string",
          "enum": ["met", "not_met", "inconclusive"]
        },
        "next_step": {
          "type": "string",
          "enum": ["stop", "continue"]
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "hashedArtifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["metric", "actual", "comparator", "expected", "matched"],
      "properties": {
        "metric": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "actual": {
          "type": ["string", "number", "boolean", "null"]
        },
        "comparator": {
          "type": "string",
          "enum": ["eq", "lte", "gte"]
        },
        "expected": {
          "type": ["string", "number", "boolean"]
        },
        "matched": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "conditionEvaluation": {
      "type": "object",
      "required": ["matched", "observations"],
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
