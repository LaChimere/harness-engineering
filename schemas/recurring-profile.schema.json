{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/recurring-profile.schema.json",
  "title": "Recurring profile",
  "description": "Declarative recurring maintenance profile contract. The CLI executes one deterministic profile run; scheduling is external.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "description",
    "cadence_hint",
    "inputs",
    "trigger",
    "stop_condition",
    "allowed_actions",
    "handoff",
    "trust_requirements"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "profile_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "profile_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "declared_capability_id": {
      "type": "null",
      "default": null
    },
    "cadence_hint": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "required"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "kind": {
            "$ref": "#/$defs/evidenceKind"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "trigger": {
      "$ref": "#/$defs/condition"
    },
    "stop_condition": {
      "$ref": "#/$defs/condition"
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["summary"]
      },
      "uniqueItems": true
    },
    "handoff": {
      "type": "object",
      "required": ["kind", "destination_hint"],
      "properties": {
        "kind": {
          "const": "profile-run"
        },
        "destination_hint": {
          "$ref": "common.schema.json#/$defs/artifactRef"
        }
      },
      "additionalProperties": false
    },
    "trust_requirements": {
      "$ref": "common.schema.json#/$defs/trustRequirements"
    }
  },
  "$defs": {
    "evidenceKind": {
      "type": "string",
      "enum": ["gc-evidence", "health-result", "profile-run"]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "conditions"],
          "properties": {
            "kind": {
              "enum": ["all", "any"]
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/metricCondition"
        }
      ]
    },
    "metricCondition": {
      "type": "object",
      "required": ["kind", "metric", "comparator", "value"],
      "properties": {
        "kind": {
          "const": "metric-threshold"
        },
        "metric": {
          "type": "string",
          "enum": ["gc.findings.count", "health.status"]
        },
        "comparator": {
          "type": "string",
          "enum": ["eq", "lte", "gte"]
        },
        "value": {
          "type": ["string", "number", "boolean"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
