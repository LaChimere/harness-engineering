{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/repair-action.schema.json",
  "title": "Repair action",
  "$comment": "provisional; distinguishes preview-backed repairs from advisory-only limited-adapter repair prompts.",
  "type": "object",
  "required": [
    "schema_version",
    "x-stability",
    "action_id",
    "target_files",
    "risk_class",
    "repair_mode",
    "equivalent_cli_command",
    "approval_state",
    "sandbox_requirement",
    "trust_requirements",
    "rollback_notes",
    "evidence_links"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "x-stability": {
      "const": "provisional"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "target_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "risk_class": {
      "$ref": "common.schema.json#/$defs/riskClass"
    },
    "repair_mode": {
      "type": "string",
      "enum": ["preview-backed", "advisory-only"]
    },
    "preview_diff": {
      "type": "string",
      "minLength": 1,
      "pattern": "^diff --git "
    },
    "equivalent_cli_command": {
      "$ref": "common.schema.json#/$defs/command"
    },
    "approval_state": {
      "type": "string",
      "enum": ["proposed", "approved", "rejected", "applied"]
    },
    "sandbox_requirement": {
      "$ref": "common.schema.json#/$defs/sandboxTier"
    },
    "trust_requirements": {
      "$ref": "common.schema.json#/$defs/trustRequirements"
    },
    "rollback_notes": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "evidence_links": {
      "$ref": "common.schema.json#/$defs/evidenceLinks"
    },
    "advisory": {
      "type": "object",
      "required": ["reason", "write_execution", "approval_guidance"],
      "properties": {
        "reason": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "write_execution": {
          "const": "cli-only"
        },
        "approval_guidance": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "repair_mode": {
            "const": "preview-backed"
          }
        },
        "required": ["repair_mode"]
      },
      "then": {
        "required": ["preview_diff"]
      }
    },
    {
      "if": {
        "properties": {
          "repair_mode": {
            "const": "advisory-only"
          }
        },
        "required": ["repair_mode"]
      },
      "then": {
        "required": ["advisory"],
        "properties": {
          "approval_state": {
            "enum": ["proposed", "rejected"]
          }
        },
        "not": {
          "required": ["preview_diff"]
        }
      }
    }
  ],
  "additionalProperties": false
}
