{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/repair-action.schema.json",
  "title": "Repair action",
  "$comment": "provisional; Stage 8/9 must confirm host-specific repair UX before writes are enabled.",
  "type": "object",
  "required": [
    "schema_version",
    "x-stability",
    "action_id",
    "target_files",
    "risk_class",
    "preview_diff",
    "equivalent_cli_command",
    "approval_state",
    "sandbox_requirement",
    "trust_requirements",
    "rollback_notes",
    "evidence_links"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "x-stability": {
      "const": "provisional"
    },
    "action_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "target_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "risk_class": {
      "$ref": "common.schema.json#/$defs/riskClass"
    },
    "preview_diff": {
      "type": "string",
      "minLength": 1,
      "pattern": "^diff --git "
    },
    "equivalent_cli_command": {
      "$ref": "common.schema.json#/$defs/command"
    },
    "approval_state": {
      "type": "string",
      "enum": ["proposed", "approved", "rejected", "applied"]
    },
    "sandbox_requirement": {
      "$ref": "common.schema.json#/$defs/sandboxTier"
    },
    "trust_requirements": {
      "$ref": "common.schema.json#/$defs/trustRequirements"
    },
    "rollback_notes": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "evidence_links": {
      "$ref": "common.schema.json#/$defs/evidenceLinks"
    }
  },
  "additionalProperties": false
}
