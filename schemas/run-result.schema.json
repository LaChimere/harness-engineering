{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/run-result.schema.json",
  "title": "Run result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "model_profile",
    "harness_version",
    "status",
    "execution",
    "usage",
    "trace",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "kind": {
      "type": "string",
      "enum": ["eval", "ad-hoc"]
    },
    "suite_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "task_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "split": {
      "type": "string",
      "enum": ["optimization", "holdout"]
    },
    "model_profile": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "harness_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "error", "skipped"]
    },
    "execution": {
      "type": "object",
      "description": "Execution semantics for verifier-only validation and Stage 6 deterministic agent runs.",
      "required": ["mode", "harness_status", "verifier_status"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["verifier-only", "agent-run"]
        },
        "harness_status": {
          "type": "string",
          "enum": ["passed", "failed", "error"]
        },
        "verifier_status": {
          "type": "string",
          "enum": ["passed", "failed", "error", "skipped"]
        },
        "agent_status": {
          "type": "string",
          "enum": ["passed", "failed", "error", "skipped"]
        },
        "model_status": {
          "type": "string",
          "enum": ["passed", "failed", "error", "skipped"]
        }
      },
      "additionalProperties": false
    },
    "failure_code": {
      "$ref": "common.schema.json#/$defs/failureCode"
    },
    "trace": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "verifier_result": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "judge_results": {
      "description": "Distinct inferential judge-result artifact links. Stage 7 report validation checks linked results, matching run ids, and advisory/blocking policy semantics; deterministic verifier status remains in verifier_result and execution.verifier_status.",
      "$ref": "common.schema.json#/$defs/evidenceLinks"
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/usageAccounting"
    },
    "artifacts": {
      "$ref": "common.schema.json#/$defs/evidenceLinks"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": [
          "suite_id",
          "task_id",
          "task_version",
          "dataset_hash",
          "split",
          "verifier_result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ad-hoc"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["suite_id"]
            },
            {
              "required": ["task_id"]
            },
            {
              "required": ["task_version"]
            },
            {
              "required": ["dataset_hash"]
            },
            {
              "required": ["split"]
            },
            {
              "required": ["verifier_result"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          },
          "execution": {
            "properties": {
              "mode": {
                "const": "agent-run"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["status", "execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "agent_status": {
                "const": "passed"
              },
              "model_status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "agent-run"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "required": ["trace"],
        "properties": {
          "trace": {
            "not": {
              "const": "harness://verifier-only/no-agent-trace"
            }
          },
          "execution": {
            "required": ["agent_status", "model_status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "verifier-only"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "execution": {
            "not": {
              "anyOf": [
                {
                  "required": ["agent_status"]
                },
                {
                  "required": ["model_status"]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          },
          "status": {
            "const": "error"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "not": {
              "properties": {
                "harness_status": {
                  "const": "passed"
                },
                "verifier_status": {
                  "const": "passed"
                }
              },
              "required": ["harness_status", "verifier_status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["failed", "error"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["failure_code"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "harness_status": {
                "const": "passed"
              },
              "verifier_status": {
                "const": "passed"
              }
            }
          }
        },
        "not": {
          "required": ["failure_code"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          },
          "status": {
            "const": "failed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "harness_status": {
                "const": "passed"
              },
              "verifier_status": {
                "const": "failed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ad-hoc"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "not": {
          "required": ["failure_code"]
        }
      }
    }
  ],
  "additionalProperties": false
}
