{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lachimere.github.io/harness-engineering/schemas/0.1/run-result.schema.json",
  "title": "Run result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "model_profile",
    "harness_version",
    "status",
    "execution",
    "usage",
    "trace",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "kind": {
      "type": "string",
      "enum": ["eval", "external-import"]
    },
    "suite_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "task_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "split": {
      "type": "string",
      "enum": ["optimization", "holdout"]
    },
    "model_profile": {
      "description": "Read-only provenance for the model profile or external model associated with this record. `harness eval validate` uses the verifier-only sentinel; host-produced evidence may use a URI. Harness does not resolve this field as configured execution.",
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "harness_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "error", "skipped"]
    },
    "execution": {
      "type": "object",
      "description": "Execution semantics for verifier-only validation and imported run records.",
      "required": ["mode", "harness_status", "verifier_status"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["verifier-only", "external-import"]
        },
        "harness_status": {
          "type": "string",
          "enum": ["passed", "failed", "error"]
        },
        "verifier_status": {
          "type": "string",
          "enum": ["passed", "failed", "error", "skipped"]
        }
      },
      "additionalProperties": false
    },
    "failure_code": {
      "$ref": "common.schema.json#/$defs/failureCode"
    },
    "trace": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "verifier_result": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "judge_results": {
      "description": "Distinct inferential judge-result artifact links. Report validation checks linked results, matching run ids, and advisory/blocking policy semantics; deterministic verifier status remains in verifier_result and execution.verifier_status.",
      "$ref": "common.schema.json#/$defs/evidenceLinks"
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/usageAccounting"
    },
    "artifacts": {
      "$ref": "common.schema.json#/$defs/evidenceLinks"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": [
          "suite_id",
          "task_id",
          "task_version",
          "dataset_hash",
          "split",
          "verifier_result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "external-import"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": [
          "suite_id",
          "task_id",
          "task_version",
          "dataset_hash",
          "split",
          "verifier_result"
        ],
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "external-import"
              }
            },
            "required": ["mode"]
          },
          "usage": {
            "properties": {
              "source": {
                "const": "external"
              }
            }
          },
          "model_profile": {
            "pattern": "^harness://external-import/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "external-import"
              }
            },
            "required": ["mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "required": ["trace"],
        "properties": {
          "kind": {
            "const": "external-import"
          },
          "trace": {
            "not": {
              "const": "harness://verifier-only/no-agent-trace"
            }
          },
          "usage": {
            "properties": {
              "source": {
                "const": "external"
              },
              "requests": {
                "const": 0
              },
              "input_tokens": {
                "const": 0
              },
              "output_tokens": {
                "const": 0
              },
              "total_tokens": {
                "const": 0
              },
              "incurred_cost_usd": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          },
          "status": {
            "const": "error"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "not": {
              "properties": {
                "harness_status": {
                  "const": "passed"
                },
                "verifier_status": {
                  "const": "passed"
                }
              },
              "required": ["harness_status", "verifier_status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "external-import"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "harness_status": {
                "const": "passed"
              },
              "verifier_status": {
                "const": "passed"
              }
            }
          }
        },
        "not": {
          "required": ["failure_code"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "external-import"
          },
          "status": {
            "const": "failed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "harness_status": {
                "const": "passed"
              },
              "verifier_status": {
                "const": "failed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["failed", "error"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["failure_code"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "harness_status": {
                "const": "passed"
              },
              "verifier_status": {
                "const": "passed"
              }
            }
          }
        },
        "not": {
          "required": ["failure_code"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "eval"
          },
          "status": {
            "const": "failed"
          }
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "harness_status": {
                "const": "passed"
              },
              "verifier_status": {
                "const": "failed"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
